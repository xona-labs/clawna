# ===========================================
# Clawna (Xona on OpenClaw) — Environment
# ===========================================

# --- OpenClaw Gateway ---
OPENCLAW_GATEWAY_TOKEN=              # Generated during onboarding (openclaw onboard)

# --- AI Provider (pick at least one) ---
ANTHROPIC_API_KEY=                   # Anthropic API key (recommended — Claude Sonnet 4)
OPENAI_API_KEY=                      # OpenAI API key (fallback — GPT-4o)

# --- Xona x402 Agent Wallet ---
XONA_WALLET_SECRET=                  # Solana private key (base58) — for paying x402 resources
XONA_WALLET_ADDRESS=                 # Solana public key — for reference
XONA_API_BASE=https://api.xona-agent.com  # x402 API base URL

# --- X (Twitter) API ---
X_API_KEY=                           # X Developer API Key (Consumer Key)
X_API_SECRET=                        # X Developer API Secret (Consumer Secret)
X_ACCESS_TOKEN=                      # X Access Token (Read+Write)
X_ACCESS_SECRET=                     # X Access Token Secret

# --- Channels (optional) ---
TELEGRAM_BOT_TOKEN=                  # Telegram bot token from @BotFather
# DISCORD_BOT_TOKEN=                 # Discord bot token
