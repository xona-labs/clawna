{
  "gateway": {
    "mode": "local",
    "http": {
      "endpoints": {
        "chatCompletions": { "enabled": true }
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "allowlist",
      "allowFrom": ["454135097"],
      "actions": {
        "sendMessage": true
      },
      "groups": {
        "*": { "requireMention": true }
      },
      "groupPolicy": "open"
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "google/gemini-2.5-flash",
        "fallbacks": ["google/gemini-3-flash-preview"]
      },
      "workspace": "/home/node/.openclaw/workspace",
      "thinkingDefault": "low",
      "contextTokens": 200000,
      "heartbeat": {
        "every": "60m",
        "target": "telegram",
        "to": "454135097",
        "activeHours": {
          "start": "08:00",
          "end": "23:00"
        },
        "prompt": "Read HEARTBEAT.md and follow it strictly. Do not infer or repeat old tasks from prior chats. If nothing needs attention, reply HEARTBEAT_OK."
      }
    },
    "list": [
      {
        "id": "xona",
        "default": true,
        "identity": {
          "name": "Xona",
          "theme": "creative AI design agent on Solana"
        },
        "groupChat": {
          "mentionPatterns": ["xona", "Xona", "@xona", "@xona_creative", "xona_creative", "clawna", "Clawna", "@clawna"]
        }
      }
    ]
  }
}
